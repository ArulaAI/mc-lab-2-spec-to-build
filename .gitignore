# After verify_setup.py runs, each service directory becomes its own Git repository.
# Ignore the inner .git directories so the parent repo does not treat them as submodules.
pgs-tta/.git
pgs-payment-processor/.git

# Facilitator package. Never part of the participant distribution -- keeping it untracked means it
# cannot leak into participant history by accident rather than by discipline.
/facilitator/

# Build output and session artifacts
target/
.claude/journey/
journey/
*.class

# Facilitator-only files — not distributed to participants
/facilitator_script.md

# Machine-specific Python path cache (created by verify_setup.py)
.claude/hooks/.python_path

# Python cache
__pycache__/

# macOS
.DS_Store

# Artifacts a participant generates by following the guide. They are real deliverables -- the
# grader reads them off the filesystem -- but they are outputs of this workspace rather than part
# of the distribution, and committing them would ship one participant's answers to the next.
docs/pair-result.txt
docs/validator-brief-tta.md
docs/validator-brief-payment-processor.md
docs/validator-report.md
docs/plans/plan.status.json
