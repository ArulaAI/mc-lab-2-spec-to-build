<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.14</version>
    <relativePath/>
  </parent>

  <groupId>com.mc.pgs.lab2</groupId>
  <artifactId>pgs-tta</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>pgs-tta</name>
  <description>Lab 2 - represented TTA translation side of the TTA to Payment Processor refund seam</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <archunit.version>1.2.1</archunit.version>
    <openapi.generator.version>7.8.0</openapi.generator.version>
    <!--
      The Payment Processor contract version this consumer is pinned to. The generated client
      under client/contract is produced from src/main/openapi/payment-processor.yaml, which is a
      copy of the producer's contract at this version. Version numbering is a lab fixture.
    -->
    <payment.processor.contract.version>1</payment.processor.contract.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <!-- The pinned contract ships on the classpath so contract alignment is mechanically
           checkable from outside this service. -->
      <resource><directory>src/main/openapi</directory><targetPath>openapi</targetPath></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- Keep the plain jar as the main artifact so the pair-verification harness can depend
               on this service. Without a classifier, repackaging replaces the main artifact with
               the executable jar, which is not usable as a dependency. -->
          <classifier>exec</classifier>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>integration-test</goal><goal>verify</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Client generation is a construction-time and remediation-time activity, not part of the
      ordinary build: the generated sources are committed. Regenerating with the same contract
      and the same config reproduces the committed artifact exactly.

          mvn -Pgenerate-client generate-sources

      The ordinary `mvn verify` never invokes the generator, so the lab needs no network.
    -->
    <profile>
      <id>generate-client</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openapitools</groupId>
            <artifactId>openapi-generator-maven-plugin</artifactId>
            <version>${openapi.generator.version}</version>
            <executions>
              <execution>
                <id>generate-processor-contract-models</id>
                <goals><goal>generate</goal></goals>
                <configuration>
                  <inputSpec>${project.basedir}/src/main/openapi/payment-processor.yaml</inputSpec>
                  <!--
                    The `spring` generator emits standalone Jackson POJOs. The `java` generator
                    was tried first and rejected: its default okhttp-gson library emits Gson
                    imports this service does not depend on, and its `native` library makes every
                    model depend on generated ApiClient/Pair helper classes, dragging ~2000 lines
                    of unused client plumbing into a repository whose generated surface is meant
                    to stay small and inspectable.
                  -->
                  <generatorName>spring</generatorName>
                  <output>${project.basedir}</output>
                  <modelPackage>com.mc.pgs.lab2.tta.client.contract</modelPackage>
                  <generateApis>false</generateApis>
                  <generateApiTests>false</generateApiTests>
                  <generateApiDocumentation>false</generateApiDocumentation>
                  <generateModelTests>false</generateModelTests>
                  <generateModelDocumentation>false</generateModelDocumentation>
                  <generateSupportingFiles>false</generateSupportingFiles>
                  <configOptions>
                    <!-- No Swagger documentation annotations: they would require a
                         swagger-annotations dependency this service has no other use for. -->
                    <documentationProvider>none</documentationProvider>
                    <annotationLibrary>none</annotationLibrary>
                    <sourceFolder>src/main/java</sourceFolder>
                    <useJakartaEe>true</useJakartaEe>
                    <serializationLibrary>jackson</serializationLibrary>
                    <openApiNullable>false</openApiNullable>
                    <hideGenerationTimestamp>true</hideGenerationTimestamp>
                  </configOptions>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
